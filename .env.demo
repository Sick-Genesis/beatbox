# Demo build environment.
#
# `vite build --mode demo` loads this. It turns on the self-contained demo:
# no Supabase, an in-memory store, and a signed-in producer POV — the build
# put on the portfolio while the real app is under development.
#
# Deliberately committed (unlike .env.local): it holds no secrets, only the
# flag that selects the demo path.
VITE_DEMO=true
