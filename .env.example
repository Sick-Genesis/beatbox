# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Both values are safe to expose in the browser:
# the anon key only grants what row-level security policies allow.
#
# .env.local is gitignored. Never commit real keys.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Shared secret appended to producer buy links as url_params[bb_secret] and
# checked by the gumroad-webhook function. Set the SAME value as the
# GUMROAD_WEBHOOK_SECRET function secret. Not a strong secret — it only
# filters spam pings; access is bound to the purchase, not to this value.
VITE_GUMROAD_LINK_SECRET=some-shared-string
